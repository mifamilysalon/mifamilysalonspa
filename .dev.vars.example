# Copy to .dev.vars for local wrangler/opennext preview.
# Do not commit .dev.vars.
# Production: use `npx wrangler secret put <NAME>` (see README).

# Required — auth session signing
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional — nightly Google reviews sync (Places API)
GOOGLE_PLACES_API_KEY=
# Place ID also saved in Admin → Settings; env is a fallback for local/dev
GOOGLE_PLACE_ID=

# Optional SMS (admin toggle ships OFF)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional email delivery (gift certificates + booking notices)
# Prefer Worker EMAIL binding. Fallback: Cloudflare Email Sending REST API token
# with Email Sending Edit permission, Resend, or Brevo (Sendinblue).
CLOUDFLARE_API_TOKEN=
RESEND_API_KEY=
BREVO_API_KEY=
# Outbound From addresses (domain must be onboarded on Cloudflare Email Sending)
MAIL_FROM=appointments@mifamilysalon.com
MAIL_FROM_APPOINTMENTS=appointments@mifamilysalon.com
MAIL_FROM_GIFTS=gifts@mifamilysalon.com
# Optional: internal alerts to admin@mifamilysalon.com (defaults to appointments@)
# MAIL_FROM_STAFF=appointments@mifamilysalon.com
MAIL_FROM_NAME=Family Hair Salon & Wellness Spa

# Instagram: no secret needed here.
# Paste Behold JSON feed URL (or Trustindex widget ID) in Admin → Settings.
# See README "Instagram feed" section.
